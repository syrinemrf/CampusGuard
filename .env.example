# DEVELOPMENT ONLY. Copy to .env and edit. Never commit .env (it is git-ignored).
ELASTIC_VERSION=8.19.10
ELASTICSEARCH_PORT=9200
MONGO_VERSION=7.0
REDIS_VERSION=7.4
KAFKA_VERSION=3.9.1
ES_JAVA_OPTS=-Xms768m -Xmx768m
ELASTICSEARCH_URL=http://elasticsearch:9200
MONGO_URI=mongodb://mongodb:27017/
MONGO_DB=sentinel
REDIS_URL=redis://redis:6379/0
BUS_BACKEND=redis
APP_PORT=8000
TZ=Africa/Tunis

# --- Web application (S2) ---
# Signs nothing sensitive by itself (sessions are server-side in Redis) but MUST be a long random value:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
FLASK_SECRET_KEY=change-this-with-a-random-secret
MAX_UPLOAD_MB=10
API_RATE_LIMIT_PER_MIN=300
# Set to true only when the app is served over HTTPS (cookie flag Secure).
SESSION_COOKIE_SECURE=false

# Initial lab accounts, created by:  docker compose exec webapp flask --app app.main seed-users
# Leave empty to let the command generate and print random passwords once (recommended).
SEED_ADMIN_PASSWORD=
SEED_ANALYST_PASSWORD=
SEED_AUDITOR_PASSWORD=

# --- Kibana (S3) ---
# URL of Kibana as seen from YOUR BROWSER (used for the embedded dashboard page /kibana).
KIBANA_PUBLIC_URL=http://localhost:5601
